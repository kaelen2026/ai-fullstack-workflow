{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-fullstack-workflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // PR previews deploy the default config with `--name aifw-web-pr-N` (no route);
  // the workflow attaches `preview-N.w3ctech.dev` as a custom domain via the API.
  // `NEXT_PUBLIC_API_URL` is baked at build time, so each environment is built
  // separately by its workflow.
  "env": {
    "dev": {
      "name": "ai-fullstack-workflow-web-dev",
      "routes": [{ "pattern": "dev.w3ctech.dev", "custom_domain": true }]
    },
    "production": {
      "name": "ai-fullstack-workflow-web",
      "routes": [{ "pattern": "w3ctech.dev", "custom_domain": true }]
    }
  }
}
