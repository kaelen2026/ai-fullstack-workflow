# Secrets for `wrangler dev` (loaded automatically; never committed).
# Copy to `.dev.vars` and fill in. In production set these with
# `wrangler secret put <NAME>` (see DEPLOYMENT.md) — do NOT put them in
# wrangler.jsonc vars.

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Google OAuth credentials (optional in dev — email/password works without them).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key for transactional email (password reset). Optional in dev —
# when unset, the reset email is logged to the wrangler console instead of sent,
# so you can copy the reset link from there. Get one at https://resend.com.
RESEND_API_KEY=
