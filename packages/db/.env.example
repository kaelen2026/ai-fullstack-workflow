# Used by drizzle-kit (db:generate / db:migrate / db:studio) only.
# Local dev: the Docker Postgres. Production: the Supabase Session/Direct
# connection string (port 5432) — see DEPLOYMENT.md.
#
# The running Worker does NOT read this file — it gets its connection from the
# Hyperdrive binding (wrangler.jsonc / Cloudflare dashboard).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
