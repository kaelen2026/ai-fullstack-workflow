{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "CORS_ORIGIN", "NEXT_PUBLIC_API_URL", "PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-types": {},
    "test": {
      "outputs": [],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
